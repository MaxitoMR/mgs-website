# ═══════════════════════════════════════════════════
# MGS Backend — Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════════════════

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PgBouncer → PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://mgs:mgs_secret@pgbouncer:6432/mgs

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Temporal ---
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mgs-tasks

# --- Datadog APM ---
DD_SERVICE=mgs-backend
DD_ENV=development
DD_VERSION=0.1.0
DD_AGENT_HOST=localhost

# --- Sentry ---
SENTRY_DSN=

# --- Blob Storage (azure | gcs) ---
BLOB_PROVIDER=azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=mgs-workflows
GCS_BUCKET=mgs-workflows
GCS_PROJECT=

# --- Rate Limiting ---
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_ORG=1000
RATE_LIMIT_WINDOW_SECONDS=60

# --- PagerDuty ---
PAGERDUTY_ROUTING_KEY=

# --- Incident.io ---
INCIDENT_IO_WEBHOOK_SECRET=
